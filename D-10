            --text-main: #1e293b;
            --text-muted: #64748b;
            --border-color: #e2e8f0;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 650px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 20px;
        }

        header {
            text-align: center;
        }

        h1 {
            font-size: 1.8rem;
            color: var(--text-main);
            margin-bottom: 5px;
        }

        .progress-badge {
            background-color: #e0e7ff;
            color: #3730a3;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
        }

        /* Card Flip Container */
        .card-container {
            width: 100%;
            height: 420px;
            perspective: 1000px;
            cursor: pointer;
        }

        .card {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            border-radius: 16px;
            box-shadow: var(--shadow);
        }

        .card.flipped {
            transform: rotateY(180deg);
        }

        .card-face {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 16px;
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            padding: 30px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card-back {
            transform: rotateY(180deg);
            direction: rtl;
            text-align: right;
        }

        .lang-label {
            font-size: 0.75rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: var(--text-muted);
            font-weight: 700;
        }

        .word-section {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin: 15px 0;
            text-align: center;
        }

        .main-word {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .audio-btn {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            color: var(--primary-color);
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .audio-btn:hover {
            background: var(--primary-color);
            color: white;
            border-color: var(--primary-color);
        }

        .examples-section {
            background: #f8fafc;
            border-radius: 12px;
            padding: 15px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .example-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            font-size: 0.95rem;
            line-height: 1.4;
            color: #334155;
        }

        .example-item .audio-btn {
            width: 26px;
            height: 26px;
            font-size: 0.75rem;
            margin-top: 2px;
        }

        .card-hint {
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* Controls */
        .controls {
            display: flex;
            gap: 10px;
            width: 100%;
            flex-wrap: wrap;
        }

        .btn {
            flex: 1;
            padding: 12px 18px;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.95rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s;
            color: white;
        }

        .btn-secondary {
            background-color: #64748b;
        }
        .btn-secondary:hover { background-color: #475569; }

        .btn-primary {
            background-color: var(--primary-color);
        }
        .btn-primary:hover { background-color: var(--primary-hover); }

        .btn-shuffle {
            background-color: #4f46e5;
            flex-basis: 100%;
        }
        .btn-shuffle:hover { background-color: #4338ca; }
    </style>
</head>
