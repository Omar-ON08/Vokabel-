        }
    ];

    let currentIndex = 0;
    const card = document.getElementById('card');
    const cardContainer = document.getElementById('cardContainer');

    function updateCard() {
        const item = vocabData[currentIndex];
        document.getElementById('deWord').textContent = item.de;
        document.getElementById('deEx1').textContent = item.deEx1;
        document.getElementById('deEx2').textContent = item.deEx2;

        document.getElementById('faWord').textContent = item.fa;
        document.getElementById('faEx1').textContent = item.faEx1;
        document.getElementById('faEx2').textContent = item.faEx2;

        document.getElementById('progress').textContent = `Karte ${currentIndex + 1} von ${vocabData.length}`;
        card.classList.remove('flipped');
    }

    function flipCard() {
        card.classList.toggle('flipped');
    }

    function nextCard() {
        currentIndex = (currentIndex + 1) % vocabData.length;
        updateCard();
    }

    function prevCard() {
        currentIndex = (currentIndex - 1 + vocabData.length) % vocabData.length;
        updateCard();
    }

    function shuffleCards() {
        for (let i = vocabData.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [vocabData[i], vocabData[j]] = [vocabData[j], vocabData[i]];
        }
        currentIndex = 0;
        updateCard();
    }

    function speakText(event, elementId, lang) {
        event.stopPropagation();
        const text = document.getElementById(elementId).textContent;
        if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = lang;
            utterance.rate = lang.startsWith('de') ? 0.88 : 0.95;
            window.speechSynthesis.speak(utterance);
        }
    }

    cardContainer.addEventListener('click', flipCard);
    updateCard();
</script>

</body>
</html>
